REPLAY_PATH=./replays
SCAN_INTERVAL_SECONDS=60
PORT=8080
# Use an interface reachable by Pangolin if it runs on another host.
BIND_ADDRESS=127.0.0.1
# Set to `id -u` if replay files are readable only by their owner.
APP_UID=10001

# Anonymous public access: global limits shared by all visitors (per app process).
API_RATE_PER_SECOND=10
API_RATE_BURST=30
STATS_CACHE_SECONDS=30
STATS_BUILD_RATE=2
STATS_BUILD_BURST=8
